# =============================================================================
# Wolin (月印千江) Home Server Self-Hosting Configuration
# Precedence: CLI flag > WOLIN_* environment variable > built-in default
# Copy to .env and customize:  cp .env.example .env
# =============================================================================

# --- Network & Storage ---
# Host bind address for Docker Compose port publishing (use 0.0.0.0:4000 for LAN access,
# or keep 127.0.0.1:4000 when exposing via Caddy / Cloudflare Tunnel).
WOLIN_HTTP_BIND=127.0.0.1:4000

# Socket address bound inside wolin-server (IP literal + port).
# Keep port 4000 inside Docker unless you also update WOLIN_CONTAINER_PORT / WOLIN_UPSTREAM.
WOLIN_LISTEN_ADDR=0.0.0.0:4000

# Persistent OpenDAL (blobs/) + Oxigraph RocksDB (graph/) storage directory.
# Set to `memory` (or pass `--in-memory`) for ephemeral in-memory mode inside Docker;
# on bare-metal CLI, omitting WOLIN_STORAGE_DIR also defaults to in-memory mode.
WOLIN_STORAGE_DIR=/data

# --- Public Identity & Multi-Tenant Routing ---
# Canonical public origin advertised in RDF IRIs, Location headers, and /.well-known/wolin.
# Change to your HTTPS domain in production (e.g. https://pod.example.org).
WOLIN_BASE_URL=http://127.0.0.1:4000

# Canonical internal ResourceUri prefix evaluated by the WAC/ACP PolicyEngine.
WOLIN_POD_PREFIX=wolin://pod

# Root domain for multi-tenant Host-header subdomain routing ({pod_id}.{domain}).
WOLIN_POD_CLOUD_DOMAIN=wolin.local

# --- Authentication & Authorization (Solid-OIDC / DID / ZITADEL) ---
# Trusted OIDC / Solid-OIDC token issuer URL.
WOLIN_OIDC_ISSUER=https://auth.wolin.id

# Optional required JWT `aud` claim (leave empty to accept Solid-OIDC `solid` / default).
WOLIN_OIDC_AUDIENCE=

# Optional bootstrap owner WebID or DID granted full WAC Read/Write/Append/Control on root.
# Example: did:key:z6Mk... or https://alice.example.org/profile/card#me
WOLIN_OWNER_WEBID=

# Require explicit DelegationGrant before AI agents (`act.sub`) can act on user resources.
WOLIN_REQUIRE_EXPLICIT_DELEGATION=false

# --- Native MCP Gateway & Limits ---
# Enable or disable Native MCP JSON-RPC (/mcp) and SSE (/mcp/sse) endpoints.
WOLIN_MCP_ENABLED=true

# Maximum accepted HTTP request body size in bytes (default: 16 MiB = 16777216).
WOLIN_MAX_BODY_BYTES=16777216

# Maximum number of concurrently open per-Pod RocksDB graph stores in LRU cache (default: 256).
WOLIN_MAX_OPEN_PODS=256

# Default per-Pod logical storage quota in bytes (default: 1 GiB = 1073741824).
WOLIN_DEFAULT_POD_QUOTA_BYTES=1073741824

# Structured log filter (supports standard tracing directives; RUST_LOG also works).
WOLIN_LOG=info,wolin_server=info,wolin_mcp=info,tower_http=info

# --- Optional: Caddy Automatic HTTPS (--profile caddy) ---
WOLIN_PUBLIC_HOST=pod.example.org
ACME_EMAIL=admin@example.org

# --- Optional: Cloudflare Tunnel Sidecar ---
# Create a tunnel in Cloudflare Zero Trust -> Networks -> Tunnels and paste token below.
CLOUDFLARE_TUNNEL_TOKEN=
